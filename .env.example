# This file is a reference. Variables must be set in the shell; .env is not automatically loaded.
# Keep your real .env, keys, documents and reports out of Git.
MEDRESEARCH_DATA_DIR=C:/private/medresearch-data
MEDRESEARCH_API_TOKEN=replace-with-output-of-medresearch-token
MEDRESEARCH_OLLAMA_URL=http://127.0.0.1:11434
MEDRESEARCH_MODEL=
MEDRESEARCH_OLLAMA_CONTEXT=32768
# For sensitive work, start the separate Ollama server with OLLAMA_NO_CLOUD=1.
MEDRESEARCH_OCR_LANGUAGES=aze+rus+eng
MEDRESEARCH_TESSERACT_CMD=tesseract
# Optional external compatible chat-completions endpoint; HTTPS required.
# MEDRESEARCH_EXTERNAL_URL=https://your-provider.example/v1
# MEDRESEARCH_EXTERNAL_KEY=your-key
