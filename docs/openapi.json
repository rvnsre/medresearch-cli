            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Page": {
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Number"
          },
          "text": {
            "type": "string",
            "maxLength": 200000,
            "title": "Text"
          },
          "method": {
            "type": "string",
            "enum": [
              "text",
              "ocr",
              "manual"
            ],
            "title": "Method",
            "default": "text"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "number",
          "text"
        ],
        "title": "Page"
      },
      "ResearchRequest": {
        "properties": {
          "digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Digest"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "digest"
        ],
        "title": "ResearchRequest"
      },
      "ReviewRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 2,
            "title": "Query"
          },
          "provider": {
            "type": "string",
            "enum": [
              "none",
              "ollama",
              "external"
            ],
            "title": "Provider",
            "default": "ollama"
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 10
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query"
        ],
        "title": "ReviewRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
